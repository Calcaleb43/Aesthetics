# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# CMS auth (required in production)
AUTH_SECRET=replace-with-a-long-random-string

# Local/bootstrap admin login via env credentials
ADMIN_EMAIL=admin@aniekanvas.com
ADMIN_PASSWORD=aniekanvas-admin

# Set to "true" to allow ADMIN_EMAIL/ADMIN_PASSWORD login in production
# ALLOW_ENV_ADMIN_LOGIN=true

# Used for logout redirects / absolute URLs / Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (native booking payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
