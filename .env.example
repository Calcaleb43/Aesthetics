# Neon Postgres connection string (required for CMS + booking)
# On Vercel/Neon, POSTGRES_URL is also accepted as a fallback.
# sslmode=require is fine; the app adds uselibpqcompat=true to silence pg driver warnings.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# POSTGRES_URL=postgresql://user:password@host/neondb?sslmode=require

# CMS auth (required in production)
AUTH_SECRET=replace-with-a-long-random-string

# Admin login — local bootstrap only (seed creates the DB user; prod uses admins table)
ADMIN_EMAIL=admin@aniekanvas.com
ADMIN_PASSWORD=aniekanvas-admin

# Used for logout redirects / absolute URLs / Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (native booking payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email alerts (Resend) — optional; in-admin notifications still work without this
RESEND_API_KEY=re_...
EMAIL_FROM="Aniekanvas Aesthetics <bookings@yourdomain.com>"

# Secures /api/cron/appointment-reminders (Vercel Cron Authorization: Bearer ...)
CRON_SECRET=replace-with-a-long-random-string

# Google Places (live reviews on homepage) — Place Details Enterprise + Atmosphere
# Enable Places API (New) on the Google Cloud project. Set Place ID in Admin → Settings.
GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=   # accepted as a fallback alias
